{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aleppo Center Cash",
  "version": "1.0.3",
  "identifier": "com.mhamedshasho.aleppocentercash",
  "build": {
    "beforeBuildCommand": "vite build --base=./",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "Aleppo Center Cash",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
